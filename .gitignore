# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.
# Patterns are deliberately NOT anchored with a leading slash: they must match
# inside every workspace (apps/web, apps/mobile, packages/design), not just the root.

# dependencies
node_modules/
.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
coverage/

# next.js
.next/
out/

# expo
.expo/
dist/
web-build/
*.orig.*
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# native builds
apps/mobile/ios/
apps/mobile/android/

# production
build/

# claude code — share launch.json, never the worktree checkouts living under .claude/
.claude/worktrees/

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
